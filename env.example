# Modèle de configuration. Copier en .env et remplir :
#
#   cp env.example .env
#
# .env n'est pas versionné (voir .gitignore) : il contient des secrets et ne
# doit jamais partir sur GitHub.

# ── Directus : la pile Docker (à remplir sur le VPS) ────────────────────────

# Mot de passe de la base PostgreSQL. Personne n'a à le taper, seul Directus
# s'en sert : autant qu'il soit long et aléatoire.
#   openssl rand -base64 32
DB_PASSWORD=

# Clé de signature des jetons de session Directus. La changer déconnecte tout
# le monde. Même méthode de génération.
DIRECTUS_SECRET=

# L'adresse publique de Directus, telle que le client la tapera dans son
# navigateur. En HTTPS.
DIRECTUS_PUBLIC_URL=https://cms.jeanmaximehanny.fr

# Compte administrateur, créé au tout premier démarrage seulement.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# ── Le site : lecture des articles au moment du build ───────────────────────

# Où le build va chercher les articles.
DIRECTUS_URL=https://cms.jeanmaximehanny.fr

# Jeton statique d'un utilisateur Directus EN LECTURE SEULE, généré depuis sa
# fiche dans l'interface. Ne pas mettre ici le jeton du compte administrateur :
# il finirait dans les secrets GitHub et donnerait les pleins pouvoirs sur le
# contenu à quiconque y accède.
DIRECTUS_TOKEN=
